/*
 * Galleria application resources.
 */

resource app_signature "application/x-vnd.Galleria";

/* One instance: opening more images or folders (from Tracker or the command
 * line) delivers them to the running application. */
resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 1,
	short_info = "Galleria",
	long_info = "A simple image browser and viewer."
};

/* Shown in Tracker's "Open with" menu for images and folders. "image" is the
 * supertype: every image type the translators read. */
resource file_types message {
	"types" = "image",
	"types" = "application/x-vnd.Haiku-icon",
	"types" = "application/x-vnd.Be-directory"
};

/* Application icon (HVIF, generated by tools/make_icon.py). */
resource(101, "BEOS:ICON") #'VICN' import "artwork/Galleria.hvif";
